# ==============================================================================
# Bookini Production Environment Variables Template
# Copy this file to '.env' on your production VPS and update the values.
# ==============================================================================

# --- Traefik & Domain Setup ---
DOMAIN_NAME=bookini.vanilles.tn

# --- Database Credentials ---
POSTGRES_DB=bookiwa7dek
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# --- Redis Setup ---
REDIS_URL=redis://redis:6379/0

# --- Backend Application Secrets & Settings ---
# Generate a strong, secure secret key using: openssl rand -hex 32
SECRET_KEY=change-me-in-production-with-a-very-secure-random-string
APP_ENV=production
LOG_LEVEL=INFO

# --- Seeding Credentials (Used to bootstrap accounts on first startup) ---
SEED_DEFAULT_USERS=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Monitoring & Observability Admin Credentials ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# --- Production image tags (required by docker-compose.prod.yml) ---
BACKEND_IMAGE=wissem020/bookini-backend:latest
FRONTEND_IMAGE=wissem020/bookini-frontend:latest
ADMIN_FRONTEND_IMAGE=wissem020/bookini-admin-frontend:latest
