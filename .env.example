# ==============================================================================
# Bookini Production Environment Variables Template
# Copy this file to '.env' on your production VPS and update the values.
# ==============================================================================

# --- Traefik & Domain Setup ---
DOMAIN_NAME=bookini.vanilles.tn

# --- Database Credentials ---
POSTGRES_DB=bookini
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis Setup ---
REDIS_URL=redis://redis:6379/0

# --- Backend Application Secrets & Settings ---
# Generate a strong, secure secret key using: openssl rand -hex 32
SECRET_KEY=change-me-in-production-with-a-very-secure-random-string
APP_ENV=production
LOG_LEVEL=INFO

# --- Seeding Credentials (Used to bootstrap accounts on first startup) ---
SEED_DEFAULT_USERS=true
SEED_USER_EMAIL=user@bookini.com
SEED_USER_PASSWORD=User123456!
SEED_ADMIN_EMAIL=admin@bookini.com
SEED_ADMIN_PASSWORD=Admin123456!
SEED_SUPER_ADMIN_EMAIL=superadmin@bookini.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123456!

# --- Monitoring & Observability Admin Credentials ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
