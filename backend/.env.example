APP_NAME=Smart Floor Reservation System API
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bookini
REDIS_URL=redis://localhost:6379/0
